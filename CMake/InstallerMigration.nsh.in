; AirPodsWindows installer migration hook.
;
; Injected into the NSIS "-Core installation" section via CPACK_NSIS_EXTRA_PREINSTALL_COMMANDS,
; so it runs after .onInit and before any file is copied. It refuses unsupported systems, then
; removes every existing AirPodsWindows installation this machine still has registered — in both
; the 32-bit and the 64-bit registry views — so the 64-bit install starts from a clean state.
;
; Failure handling: a stale entry (uninstaller missing) is dropped and skipped, leftover files are
; removed with `RMDir /r`, and only real FILES still inside the directory after one retry abort the
; install. An empty surviving directory does NOT abort: CPack sets SetOutPath "$INSTDIR" before this
; hook runs, so the installer's own working directory is the old install directory and Windows
; forbids deleting it - the empty shell is a clean state the installer can write into.

SetRegView 64
ReadRegStr $R0 HKLM \
  "SYSTEM\CurrentControlSet\Control\Session Manager\Environment" "PROCESSOR_ARCHITECTURE"
StrCmp $R0 "AMD64" apd_check_windows_version
MessageBox MB_OK|MB_ICONSTOP \
  "AirPodsWindows requires Windows 10 or Windows 11 x64. 32-bit Windows and ARM64 are not supported." \
  /SD IDOK
Abort

apd_check_windows_version:
ReadRegStr $R1 HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion" "CurrentBuildNumber"
IntCmp $R1 17763 apd_stop_running apd_windows_too_old apd_stop_running

apd_windows_too_old:
MessageBox MB_OK|MB_ICONSTOP \
  "AirPodsWindows requires Windows 10 version 1809 (build 17763) or newer." \
  /SD IDOK
Abort

apd_stop_running:
; A running instance keeps its files locked, which makes both the old uninstaller and the new
; copy step fail. Close every possible legacy instance first; taskkill is a no-op when absent.
nsExec::ExecToStack 'taskkill /F /IM AirPodsWindows.exe'
Pop $R0
Pop $R0
nsExec::ExecToStack 'taskkill /F /IM AirPodsDesktop.exe'
Pop $R0
Pop $R0
Sleep 750

SetRegView 32
StrCpy $R8 0

apd_scan_view:
StrCpy $R0 0

apd_scan:
EnumRegKey $R1 HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall" $R0
StrCmp $R1 "" apd_next_view
IntOp $R0 $R0 + 1
ReadRegStr $R2 HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\$R1" "DisplayName"
StrCpy $R3 $R2 14
StrCmp $R3 "AirPodsWindows" 0 apd_scan
ReadRegStr $R3 HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\$R1" "UninstallString"
StrCmp $R3 "" apd_drop_stale_entry

; Strip the quotes CPack wraps around the uninstaller path.
StrCpy $R5 $R3 1 0
StrCmp $R5 "$\"" 0 +2
StrCpy $R3 $R3 "" 1
StrCpy $R5 $R3 1 -1
StrCmp $R5 "$\"" 0 +2
StrCpy $R3 $R3 -1
IfFileExists "$R3" apd_ask_remove 0

apd_drop_stale_entry:
; The entry points at a uninstaller that no longer exists (a previous partial removal). Drop the
; key instead of failing the whole install, then keep looking for further installations.
DeleteRegKey HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\$R1"
Goto apd_scan

apd_ask_remove:
MessageBox MB_YESNO|MB_ICONEXCLAMATION \
  "$R2 must be removed before installing this version. Continue?" \
  /SD IDYES IDYES apd_run_uninstaller IDNO apd_migration_abort

apd_run_uninstaller:
StrCpy $R7 0
ClearErrors
StrLen $R5 "\Uninstall.exe"
StrCpy $R6 $R3 -$R5
ExecWait '"$R3" /S _?=$R6' $R4
ClearErrors

; The old uninstaller removes what it installed but never empties the directory: logs, settings
; and the uninstaller itself can survive, and some builds exited non-zero after a partial removal.
; Delete the uninstaller and force-remove the old install directory, then verify.
Delete "$R3"
RMDir /r "$R6"
Goto apd_verify_cleanup

apd_retry_cleanup:
; Second attempt after a pause: transient holders (antivirus scans, an instance that raced the
; prompt) usually release within a moment.
Sleep 500
nsExec::ExecToStack 'taskkill /F /IM AirPodsWindows.exe'
Pop $R9
Pop $R9
RMDir /r "$R6"

apd_verify_cleanup:
; Only FILES inside count as failure - see the header note on why the directory shell survives.
; FindFirst wraps FindFirstFile, which lists "." and ".." as the first two entries; skip them.
; NSIS general-purpose registers stop at $R9 - use $R4 (the dead ExecWait exit code) for names.
ClearErrors
FindFirst $R9 $R4 "$R6\*.*"

apd_dots_skip:
  StrCmp $R4 "" apd_dir_clean
  StrCmp $R4 "." apd_dots_next
  StrCmp $R4 ".." apd_dots_next
  FindClose $R9
  StrCmp $R7 "1" apd_uninstall_failed
  StrCpy $R7 1
  Goto apd_retry_cleanup

apd_dots_next:
  FindNext $R9 $R4
  Goto apd_dots_skip

apd_dir_clean:
  FindClose $R9
  ClearErrors

apd_rescan:
; Restart the enumeration: removing a key shifts the remaining indexes.
StrCpy $R0 0
Goto apd_scan

apd_next_view:
IntOp $R8 $R8 + 1
StrCmp $R8 1 apd_scan_64bit apd_migration_done

apd_scan_64bit:
; Some installations register in the 64-bit view (for example a manually installed portable copy
; that ran its uninstaller from an elevated 64-bit context). Look there too.
SetRegView 64
Goto apd_scan_view

apd_uninstall_failed:
MessageBox MB_OK|MB_ICONSTOP \
  "The existing AirPodsWindows installation could not be fully removed because some files are still in use. Close every AirPodsWindows window (check the notification area), remove it from Settings > Apps, then run this installer again." \
  /SD IDOK
Abort

apd_migration_abort:
Abort

apd_migration_done:
SetRegView 64
